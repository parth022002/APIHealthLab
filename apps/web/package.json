{
  "name": "@api-healthlab/web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "API HealthLab React/Vite web application",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node -e \"const fs=require('fs'); fs.cpSync('../../dist', './dist', {recursive: true, force: true});\"",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@api-healthlab/catalog": "workspace:*",
    "@api-healthlab/core": "workspace:*",
    "@api-healthlab/provider-kit": "workspace:*",
    "@api-healthlab/providers": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.3"
  }
}
