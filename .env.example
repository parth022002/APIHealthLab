# SAFE TEMPLATE ONLY — do not add real credentials.
# Hosted Worker secrets should be configured with the platform's secret-binding mechanism,
# not committed to this file. Keep development/staging/production secrets separate.

# Local development web origin (non-secret)
PUBLIC_WEB_ORIGIN=http://localhost:5173

# Hosted-only settings. Keep empty until the Worker/Turnstile path is implemented.
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_ACTION=credential_test
# TURNSTILE_SECRET_KEY must be set as a protected Worker secret, not in a committed file.
# RATE_LIMIT_HMAC_KEY must be set as a protected Worker secret; generate a cryptographically
# random key and use a distinct value per environment.

# External provider credentials belong in the developer's local shell/secret manager and are
# not copied into this template. CLI examples may read e.g. OPENAI_API_KEY from the environment.
